.b15
	background-color c-5
	padding-top 80px
	padding-bottom 100px
	.wancho
		max-width 620px
	.b8subtitle
		font-size 16px
		font-weight 400
		color c-1
		span
			position absolute
			left 0
			bottom 0
			top 0
			display flex
			align-items center
	.b8item
		// border-bottom 1px solid #D2CCC2
		&:first-child
			border-top none
		&:last-child
			border-bottom none
	.b8container
		padding 10px 50px 32px 70px
	.b8head
		padding: 20px 40px 20px 70px
		&:before
			content "\e902"
			color #AFAAA1
			font-size 20px
		&:after
			content "\e90f"
			font-size 3px
			color c-4
	@media screen and (max-width 745px)
		.b8subtitle
			line-height 20px
			
.b15-title
	font-size 25px
	font-weight 700
	color c-1
	letter-spacing: -0.02em
	margin-bottom 60px