.g-input-radio
	width 25%
	input
		display none
		&:checked
			+ label
				&:after
					opacity 1
				&:before
					border 2px solid c-18
	label
		display flex
		font-size 16px
		color #6B6B6C
		letter-spacing 0.005em
		align-items center
		position relative
		&:before
			content ""
			width 20px
			height 20px
			border-radius 100%
			border 2px solid c-0
			display inline-block
			margin-right 20px
			box-sizing border-box
		&:after
			content ""
			width 12px
			height 12px
			border-radius 100%
			background-color c-18
			position absolute
			top 4px
			left 4px
			opacity 0
			box-sizing border-box
	@media screen and (max-width 480px)
		width 50%
			

@media screen and (max-width 960px)
	.g5-input.two-inner
		width 100%			
@media screen and (max-width 745px)
	.g5-input-three
		.g5-input, .g5-select ,.g5-textarea
			width 100%	
@media screen and (max-width 640px)	
	.g5-politicas	
		margin-top 30px
	.g5-input-two:not(.b23-tipodoc)
		flex-direction column
		.g5-input, .g5-select
			width 100%
			
	.g5-input-two.two-in-two, .g5-input.two-inner
		margin-bottom 0
