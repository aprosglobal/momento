// 		height auto
		
.b49-right-bg
	width 510px
	height 756px
	background-position center
	background-size cover
	box-sizing border-box
	@media screen and (max-width 1000px)
		margin 0 auto
	@media screen and (max-width 745px)
		height 500px
		width 335px
