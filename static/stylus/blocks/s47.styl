.b47
	padding-top 126px
	background-color c-5
	padding-bottom 112px
	box-sizing border-box
	@media screen and (max-width 745px)
		padding-top 60px
		padding-bottom 55px
	
.b47-title-top
	max-width 938px
	margin-bottom 52px
	font-weight 700
	font-size 60px
	line-height 76px
	color c-1
	@media screen and (max-width 1000px)
		max-width 750px
		font-size 40px
		line-height 48px
	@media screen and (max-width 745px)
		font-size 30px
		letter-spacing normal
		line-height 36px
		margin-bottom 30px
		max-width 100%
	@media screen and (max-width 480px)
		font-size 25px
		line-height 30px
		

.b47-list
	display flex
	flex-flow row wrap
	
.b47-foto
	img
		max-width 100%
		height auto
		width 100%
		filter: grayscale(1)
	
.b47-item
	width 23.5%
	margin-left 2%
	margin-bottom 4%
	margin-right 0%
	&:first-child
		margin-left 0%
	&:nth-child(4n+1)
		margin-left 0%
	@media screen and (max-width 1000px)
		width 32%
		&:nth-child(4n+1)
			margin-left 2%
		&:nth-child(3n+1)
			margin-left 0%
		&:first-child
			margin-left 0%
	@media screen and (max-width 745px)
		width 49%
		&:nth-child(4n+1)
			margin-left 0%
		&:nth-child(3n+1)
			margin-left 2%
		&:nth-child(2n+1)
			margin-left 0%
		&:first-child
			margin-left 0%
	@media screen and (max-width 480px)
		width 100%
		margin-left 0%
		
.b47-text-about
	margin-top 22px	
	h3
		font-size 20px
		color c-1
		letter-spacing 0.0015em
		font-weight 600
		line-height 28px
		color c-1
		@media screen and (max-width 1000px)
			font-size 18px
			line-height 25px
