.b16-menu-overlay
	position fixed
	top 0
	left 0
	background-color black
	width 100%
	height 0%
	opacity 0
	cursor pointer
	transition opacity 0.45s ease
	z-index 110
	overflow hidden
	transition-delay .5s
	&.active
		height 100%
		opacity 0.6
		transition-delay 0s


.b16
	width 100%
	height 100vh
	margin 0
	z-index 150
	position fixed
	overflow auto
	top 0
	right 0
	transition all 0.6s cubic-bezier(0.16, 1, 0.3, 1)
	transform translateY(-110%)
	.g0-btn
		width auto
		padding 0 25px
	&.active
		transform translateY(0%)
		&.moveleft
			transform translateY(-110%)
	&.hide
		visibility hidden
		opacity 0
		transition inherit
	@media screen and (max-width 767px)
		background-color c-5
		height 100vh
		overflow auto

.b16-wrap
	display flex
	flex-flow row wrap
	@media screen and (max-width 745px)
		flex-direction column-reverse
.b16-left
	width 45.2%
	padding-top 146px
	background-color c-12
	padding-bottom 82px
	padding-left 135px
	padding-right 140px
	box-sizing border-box
	position relative
	@media screen and (max-width 1180px)
		padding-left 60px
		padding-right 60px
	@media screen and (max-width 1000px)
		padding-left 30px
		padding-right 30px
	@media screen and (max-width 745px)
		width 100%
		padding-top 80px
		padding-bottom 30px
		position inherit
.b16-close
	color c-4
	font-size 25px
	position absolute
	top 25px
	left 100px
	z-index 60
	@media screen and (max-width 1180px)
		left 50px
	@media screen and (max-width 1000px)
		left 25px
.b16-bg
	background-size cover
	background-position center
	width 372px
	display block
	height 528px
	box-sizing border-box
	@media screen and (max-width 1180px)
		width 360px
		height 450px
	@media screen and (max-width 1000px)
		width 285px
		height 390px
	@media screen and (max-width 480px)
		width 262px
.b16-title-red
	font-weight 300
	font-size 16px
	line-height 20px
	letter-spacing: -0.05em
	color rgba(c-0, 0.8)
	margin-bottom 15px
.b16-redes
	margin-top 28px
	padding-left 40px
	@media screen and (max-width 1000px)
		margin-top 50px
		padding-left 10px
.b16-list-redes
	display flex
.b16-red
	margin 0
	margin-left 14px
	color c-10
	font-size 22px
	transition all -3s
	&:first-child
		margin-left 0
	&:hover
		color c-4
.b16-right
	width 54.7%
	background-color c-5
	padding-top 112px
	padding-left 196px
	padding-right 30px
	box-sizing border-box
	position relative
	@media screen and (max-width 1180px)
		padding-left 80px
	@media screen and (max-width 1000px)
		padding-left 40px
	@media screen and (max-width 745px)
		width 100%
		padding-top 70px
		padding-bottom 20px
