.b16-link-menu
	font-weight 300
	font-size 35px
	letter-spacing: -0.05em
	height 65px
	transition all .3s
	display flex
	align-items center
	color c-0
	i
		margin-left 8px
		font-size 23px
	&.b16-link-menu-687
		&:after
			content '\e90a'
			font-family icomoon
			font-size 24px
			margin-left 13px
			margin-top 2px
	&:hover
		color c-4
	&.active 
		color c-4
	@media screen and (max-width 1180px)
		font-size 30px
	@media screen and (max-width 1000px)
		font-size 25px
	
	
	