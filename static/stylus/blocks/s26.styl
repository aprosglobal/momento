.b26
	padding-top 80px
	overflow hidden
.b26-text
	max-width 680px
	margin 0 auto
	z-index 3
	position relative
	padding-left 20px
	padding-right 20px
	box-sizing border-box
.b26-title
	font-weight 700
	font-size 48px
	color c-1
	margin-bottom 22px
	text-align center
	@media screen and (max-width 1000px)
		font-size 35px
	@media screen and (max-width 745px)
		font-size 25px
.b26-description
	font-weight 300
	font-size 16px
	color c-1
	letter-spacing: 0.005em
	text-align center
	p
		margin 0
	@media screen and (max-width 745px)
		font-size 14px
.b26-mapa
	background-size cover
	background-position center
	height 100vh
	width 100%
	margin-top -28px
	position relative
	&:after
		content ""
		left 0
		top 0
		position absolute
		width 100%
		height 246px
		z-index 1
		background: linear-gradient(360deg, rgba(248, 246, 243, 0) 0%, #FFFFFF 100%)
	&:before
		content ""
		left 0
		bottom 0
		position absolute
		height 221px
		width 100%
		background: linear-gradient(360deg, #F8F6F3 0%, rgba(255, 255, 255, 0) 100%)
		z-index 1
	@media screen and (max-width 1000px)
		height 460px
		
	