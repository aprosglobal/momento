.b24
	background-size cover
	background-position center
	width 100%
	position relative
	&:after
		content ""
		position absolute
		left 0
		top 0
		width 100%
		height 272px
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.49) -5.65%, rgba(33, 47, 53, 0) 100%)
		z-index 1
	.wancho
		height 560px
		position relative
		z-index 2
		padding-top 130px
		box-sizing border-box

	@media screen and (max-width 745px)
		.wancho
			height 400px
.b24-text
	max-width 640px
	margin 0 auto
.b24-title
	margin-bottom 100px
	font-size 25px
	font-weight 700
	text-align center
	color c-5
	@media screen and (max-width 745px)
		font-size 20px
.b24-subtitle
	margin 0
	font-weight 600
	font-size 34px
	line-height 44px
	color c-5
	@media screen and (max-width 745px)
		font-size 26px
		line-height 35px
	
	
		