.b20
	padding-bottom 70px
	background-color c-6
	box-sizing border-box
	overflow hidden
	.wancho	
		max-width 1400px
	.owl-stage-outer
		overflow visible
		@media screen and (max-width 1000px)
			overflow hidden

.b20-fila-top
	padding-top 63px
	display flex
	box-sizing border-box
	align-items center
	justify-content space-between
	padding-bottom 40px
	padding-left 80px
	position relative
	background-color c-5
	&:after
		content ""
		top 0
		left 100%
		width 100%
		height 100%
		position absolute
		background-color c-5
	&:before
		content ""
		top 0
		right 100%
		width 100%
		height 100%
		position absolute
		background-color c-5
	@media screen and (max-width 1180px)
		padding-left 0
	@media screen and (max-width 1000px)
		flex-flow row wrap
		padding-bottom 20px
.b20-title-top
	font-size 60px
	font-weight 500
	line-height 68px
	max-width 753px
	@media screen and (max-width 1180px)
		max-width 570px
		font-size 45px
		line-height 53px
	@media screen and (max-width 1000px)
		max-width none
		margin-bottom 30px
		font-size 35px
		line-height 36px
	@media screen and (max-width 745px)
		font-size 30px
		line-height 36px
		margin-bottom 25px
.b20-decription-top
	font-size 16px
	font-weight 300
	line-height 26px
	max-width 310px
	@media screen and (max-width 1000px)
		max-width none
		
.b20-content-slider
	position relative
	z-index 1
	&:after
		position absolute
		content ""
		background-color c-6
		left -400px
		z-index 2
		top 0
		height 100%
		width 400px

.b20-slider
	width 100%

.b20-item-sl
	margin-right 4px
.b20-fila-center
	background-size cover
	background-position center
	width 100%
	height 684px
	@media screen and (max-width 1000px)
		height 400px
	@media screen and (max-width 480px)
		height 300px
	
.b20-fila-down
	display flex
	align-items center
	justify-content space-between
	padding-left 116px
	box-sizing border-box
	background-color c-6
	margin-top 38px
	@media screen and (max-width 1180px)
		padding-left 0
		padding-right 0
	@media screen and (max-width 745px)
		flex-flow row wrap
.b20-left-down
	max-width 640px
	h4
		margin 0
		font-weight 700
		font-size 48px
		margin-bottom 15px
	p
		margin 0
		font-weight 300
		font-size 16px
		line-height 26px
		letter-spacing: 0.005em
		max-width 438px
	@media screen and (max-width 1000px)
		max-width 420px
		h4
			font-size 32px
	@media screen and (max-width 745px)
		width 100%
.b20-pager
	color #D3DCE2
	font-size 46px
	font-weight 700
	em
		color c-16
	span
		&.active
			color c-4
	@media screen and (max-width 1000px)
		font-size 32px
.b20-control
	display flex
	margin-left 30px

.b20-right-down
	position absolute
	right 0
	bottom 30px
	z-index 3
	display flex
	max-width 320px
	margin-left 20px
	box-sizing border-box
	@media screen and (max-width 745px)
		width 100%
		margin-left 0
		position relative
		bottom 0
		margin-top 30px
		justify-content center
		align-items center
.b20-prev-control, .b20-next-control
	width 50px
	height 50px
	display flex
	margin 0
	align-items center
	justify-content center
	border-radius 100%
	border 1px solid c-4
	color c-4
	font-size 10px
	cursor pointer
	&:hover
		transition all .3s
		border #334049
		color #334049
.b20-next-control
	margin-left 11px
	
	
		
	
	