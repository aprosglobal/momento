.b22
	padding 90px 0px
	background-color c-5
	box-sizing border-box
	@media screen and (max-width 745px)
		padding-top 30px
		padding-bottom 40px
	.wancho
		display flex
		flex-flow row wrap
		justify-content space-between
		align-items flex-end
		&.form-center
			justify-content center
	.owl-nav
		display flex
		justify-content center
		position absolute
		left 0
		bottom 25px
		right 0
		position absolute
		&.disabled
			display none
	.owl-prev, .owl-next
		width 50px
		height 50px
		display flex
		align-items center
		justify-content center
		border-radius 100%
		border 1px solid c-4
		color c-4
		font-size 10px
		cursor pointer
		transition all .3s
		&:hover
			transition all .3s
			border #334049
			color #334049
	.owl-next
		margin-left 11px
	@media screen and (max-width 1000px)
		.wancho
			max-width 550px
.b22-left
	width 43.6%
	@media screen and (max-width 1000px)
		width 100%
		margin-bottom 40px
.b22-title
	font-size 34px
	line-height 44px
	font-weight 600
	color c-1
	margin-bottom 32px
	@media screen and (max-width 1000px)
		font-size 25px
		line-height 30px

.b22-content-slider
	box-sizing border-box
	display flex
	align-items center
	justify-content center
	border 1px solid c-12
	position relative
.b22-item-sl
	box-sizing border-box
	display flex
	align-items center
	justify-content center
	min-height 471px
	box-sizing border-box
	@media screen and (max-width 1000px)
		min-height 400px
.b22-plano
	position relative
	text-align center
	img
		max-width 100%
		height auto
		display block
.b22-lupa
	display flex
	align-items center
	justify-content center
	border-radius 100%
	background-color c-4
	color c-5
	height 46px
	width 46px
	top 0
	left 0
	bottom 0
	right 0
	position absolute
	
.b22-right
	width 49%
	@media screen and (max-width 1000px)
		width 100%
	