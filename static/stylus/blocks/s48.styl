.b48
	padding-top 43px
	padding-bottom 70px
	box-sizing border-box
	img
		max-width 100%
		height auto

.b48-top
	margin-bottom 38px
	@media screen and (max-width 768px)
		margin-bottom 25px

.b48-title
	font-weight 700
	font-size 25px
	line-height 35px
	letter-spacing -0.02em
	color c-1
	
.b48-list
	display flex
	justify-content space-between
	align-items center
	@media screen and (max-width 768px)
		flex-flow row wrap
		justify-content center
	
.b48-item
	width 32%
	margin-left 2%
	&:first-child
		margin-left 0%
	@media screen and (max-width 768px)
		width 48%
		margin-bottom 2%
		&:last-child
			margin-left 0%
			margin-bottom 0%
	@media screen and (max-width 480px)
		width 100%
		margin-left 0%
		margin-bottom 4%
		text-align center

.b48-cargo
	max-width 384px
	margin 0 auto
	margin-top 19px
	text-align left
	
.b48-name
	font-weight 600
	font-size 20px
	line-height 28px
	letter-spacing 0.0015em
	@media screen and (max-width 1000px)
		font-size 18px
		line-height 26px
	@media screen and (max-width 480px)
		font-size 16px
		line-height 25px
	
.b48-description
	font-weight 400
	font-size 16px
	line-height 20px
	letter-spacing 0.0015em
	@media screen and (max-width 1000px)
		font-size 14px
		line-height 18px
	@media screen and (max-width 480px)
		font-size 12px
		line-height 16px

.b48-right
	margin-right 30.5%
	
	