.b1
	position relative
	.owl-nav
		display none
	.owl-dots
		display flex
		align-items center
		justify-content center
		flex-direction column
		position absolute
		top 0px
		right 120px
		bottom 0
	.owl-dot
		display flex
		justify-content center
		align-items center
		width 20px
		height 20px
		border-radius 100%
		border 1px solid transparent
		cursor pointer
		margin-bottom 25px
		position relative
		&:after
			content ""
			top 0
			left 0
			right 0
			bottom 0
			position absolute
			width 10px
			height 10px
			border-radius 100%
			background-color rgba(c-5, 0.4)
			margin  auto
		&:first-child
			margin-left 0
		&:hover, &.active
			transition all .3s
			border 1px solid rgba(c-5, 0.4)
	@media screen and (max-width 1350px)
		.owl-dots
			right 50px
	@media screen and (max-width 1000px)
		.owl-dots
			flex-direction: inherit
			bottom 40px
			top inherit
			right 0
			left 0
		.owl-dot
			margin-left 25px
			margin-bottom 0
.b1-item-sl
	background-size cover
	background-position center
	height 100%
	width 100%
	position relative
	&:after
		content ""
		left 0
		top 0
		width 100%
		height 100%
		background-color c-1
		opacity 0.3
		position absolute
		z-index 1
	.wancho
		height 100vh
		display flex
		align-items center
		justify-content center
		z-index 3
		position relative
	.g0-cnt-btn
		opacity 0
		transform translateX(-100px)
		transition all .4s
	&.animate
		.b1-title
			opacity 1
			transform translateX(0px)
			transition-delay .5s
		.g0-cnt-btn
			opacity 1
			transform translateX(0px)
			transition-delay .75s
	@media screen and (max-width 1000px)
		.wancho
			height 650px
.b1-title
	font-weight 300
	font-size 50px
	max-width 450px
	margin 0 auto
	line-height 68px
	color c-5
	letter-spacing: -0.05em
	text-align center
	margin-bottom 45px
	opacity 0
	transform translateX(-100px)
	transition all .4s
	@media screen and (max-width 745px)
		font-size 40px
		line-height 48px
		
	
.b1-link
	color c-5
	display flex
	align-items center
	transition all .3s
	i
		font-size 10px
		margin-right 10px
		color c-5
	span
		font-size 14px
		color c-5
		font-family t-0
		text-transform uppercase
	@media screen and (min-width 1025px)
		&:hover
			transition all .3s
			transform: translateX(20px)
			